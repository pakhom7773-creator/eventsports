<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.sportsevents.controllers.MainController"
            style="-fx-background-color: #f8fafc;">
   
   <!-- Top Menu -->
   <top>
      <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;">
         <Label fx:id="userNameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
         <Label fx:id="userRoleLabel" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-padding: 5 10; -fx-background-radius: 5;"/>
         <Region HBox.hgrow="ALWAYS"/>
         <Button fx:id="adminButton" text="Админ-панель" style="-fx-background-color: #7c3aed; -fx-text-fill: white;" onAction="#handleAdmin"/>
         <Button fx:id="createEventButton" text="Создать мероприятие" style="-fx-background-color: #2563eb; -fx-text-fill: white;" onAction="#handleCreateEvent"/>
         <Button fx:id="logoutButton" text="Выйти" onAction="#handleLogout"/>
      </HBox>
   </top>
   
   <!-- Center Content -->
   <center>
      <VBox spacing="20" style="-fx-padding: 20;">
         <!-- Filters -->
         <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
            <Label text="Поиск и фильтры" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
               <TextField fx:id="searchField" promptText="Поиск по названию" HBox.hgrow="ALWAYS"/>
               <ComboBox fx:id="sportFilter" promptText="Вид спорта" prefWidth="150"/>
               <TextField fx:id="cityFilter" promptText="Город" prefWidth="150"/>
               <DatePicker fx:id="fromDate" promptText="От" prefWidth="120"/>
               <DatePicker fx:id="toDate" promptText="До" prefWidth="120"/>
               <Button fx:id="searchButton" text="Найти" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>
            </HBox>
         </VBox>
         
         <!-- Events Grid -->
         <ScrollPane fitToWidth="true">
            <GridPane fx:id="eventsGrid" hgap="15" vgap="15" style="-fx-padding: 10;"/>
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>




